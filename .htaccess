# ===== نظام إدارة المستندات والتحقق عبر QR =====
Options -Indexes

# حماية مجلدات النظام من الوصول المباشر
RewriteEngine On

RewriteRule ^(app|config|database|vendor|storage|views|tests)/ - [F,L]

# منع الوصول إلى ملفات الإعدادات والملفات المحلية
<FilesMatch "^(config\.php|\.htaccess|\.env|start\.bat)$">
    Require all denied
</FilesMatch>

# إخفاء رقم إصدار الخادم وترويسة PHP
ServerSignature Off
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# توجيه جميع الطلبات إلى ملف الدخول الرئيسي
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
